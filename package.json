{
  "name": "@moosewave/sdk-workbench",
  "version": "0.1.1",
  "description": "Existing Moosewave TypeScript SDK, isolated with API contract fixtures and offline verification.",
  "keywords": [
    "postwave",
    "email",
    "newsletter",
    "marketing-automation",
    "transactional-email",
    "agent",
    "agents",
    "ai",
    "mcp",
    "sdk",
    "typescript"
  ],
  "author": "Moosewave",
  "license": "MIT",
  "homepage": "https://moosewave.com/forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh2929/postwave-mit-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/harsh2929/postwave-mit-workbench/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "import": "./dist/webhook.js",
      "require": "./dist/webhook.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "generate:operations": "node scripts/generate-operations.mjs",
    "generate:operations:check": "node scripts/generate-operations.mjs --self-test && node scripts/generate-operations.mjs --check",
    "verify": "npm run lint && npm run typecheck && npm run generate:operations:check && npm run test && npm run build && npm run test:package && npm run audit:bundle",
    "test:package": "node --test scripts/package-exports.test.mjs",
    "audit:bundle": "python3 scripts/audit-bundle.py"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.19.18",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "typescript-eslint": "8.72.2",
    "openapi-typescript": "7.13.0",
    "vite": "7.3.8"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "private": true,
  "overrides": {
    "minimatch": "11.0.8",
    "esbuild": "0.28.2"
  }
}
